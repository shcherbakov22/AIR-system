[Unit]
Description=School platform speech announcement worker
After=network.target sound.target postgresql.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/var/www/school-system-redo/platform
ExecStart=/usr/bin/php artisan speech:play-announcements --device=plughw:0,0 --idle-sleep-ms=1500
Restart=always
RestartSec=2
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target

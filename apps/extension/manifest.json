{
  "manifest_version": 3,
  "name": "School System Extension",
  "version": "0.1.0",
  "description": "Browser extension client for the School System platform.",
  "permissions": ["alarms", "storage"],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "School System Extension"
  }
}
